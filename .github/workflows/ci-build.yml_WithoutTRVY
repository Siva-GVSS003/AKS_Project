name: CI Build Pipeline

on:
  push:
    branches:
      - develop
      - qa
      - staging

env:
  ACR_NAME: tejaacr

jobs:

########################################
# USER SERVICE
########################################
  user-service:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v3

    - name: Setup Java
      uses: actions/setup-java@v3
      with:
        distribution: temurin
        java-version: 17

    - name: Cache Maven
      uses: actions/cache@v3
      with:
        path: ~/.m2
        key: ${{ runner.os }}-m2-user-${{ hashFiles('microservices/user-service/pom.xml') }}
        restore-keys: |
          ${{ runner.os }}-m2

    - name: Sonar + Build (User Service)
      working-directory: microservices/user-service
      run: |
        mvn clean verify sonar:sonar \
          -Dsonar.projectKey=user-service \
          -Dsonar.host.url=${{ secrets.SONAR_HOST_URL }} \
          -Dsonar.login=${{ secrets.SONAR_TOKEN }}

    - name: Login Azure
      uses: azure/login@v1
      with:
        creds: ${{ secrets.AZURE_CREDENTIALS }}

    - name: Login ACR
      run: az acr login --name $ACR_NAME

    - name: Docker Build & Push (User Service)
      working-directory: microservices/user-service
      run: |
        docker build -t $ACR_NAME.azurecr.io/user-service:${{ github.sha }} .
        docker push $ACR_NAME.azurecr.io/user-service:${{ github.sha }}
        docker tag $ACR_NAME.azurecr.io/user-service:${{ github.sha }} $ACR_NAME.azurecr.io/user-service:latest
        docker push $ACR_NAME.azurecr.io/user-service:latest


